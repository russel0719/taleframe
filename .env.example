# 배포는 GitHub Pages (.github/workflows/pages.yml) — 아래 값은 Actions 가 채운다. 로컬은 비워 둔다
# 경로 접두사 (프로젝트 사이트면 "/<repo>")
NEXT_PUBLIC_BASE_PATH=
# 공유 카드 절대 URL 기준 (예: https://<user>.github.io/<repo>)
NEXT_PUBLIC_SITE_URL=
# (선택) 미디어를 다른 호스트로 옮길 때만
NEXT_PUBLIC_MEDIA_BASE_URL=
# (선택) tf validate --remote 가 확인할 사이트 주소. 없으면 origin 에서 추정
TALEFRAME_SITE_URL=
