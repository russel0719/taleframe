# 공용 Supabase 프로젝트 (Storage 버킷 taleframe 만 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 로컬 CLI(`npm run tf -- upload`)만 쓴다. Vercel 에는 넣지 않아도 된다
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 미디어 URL 강제 지정. 비우면: 로컬=/media, 프로덕션=Supabase Storage public URL
NEXT_PUBLIC_MEDIA_BASE_URL=
# (선택) 공유 카드 절대 URL 기준. Vercel 프로덕션은 자동
NEXT_PUBLIC_SITE_URL=
